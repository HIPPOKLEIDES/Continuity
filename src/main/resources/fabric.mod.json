{
  "schemaVersion": 1,
  "id": "continuity",
  "version": "${version}",

  "name": "Continuity Expanded",
  "description": "A fork of Continuity by PepperCode1 that replaces it. Adds overlays that fit slabs, layers and other shapes, block tags in matchBlocks and connectBlocks, and more. Continuity allows resource packs that use the OptiFine connected textures format or OptiFine emissive textures format (only for blocks and item models) to work without OptiFine.",
  "authors": [
    "PepperCode1"
  ],
  "contributors": [
    "HIPPOKLEIDES"
  ],
  "contact": {
    "homepage": "https://github.com/HIPPOKLEIDES/Continuity",
    "issues": "https://github.com/HIPPOKLEIDES/Continuity/issues",
    "sources": "https://github.com/HIPPOKLEIDES/Continuity"
  },

  "license": "LGPL-3.0-only",
  "icon": "assets/continuity/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "me.pepperbell.continuity.client.ContinuityClient"
    ],
    "modmenu": [
      "me.pepperbell.continuity.client.config.ModMenuApiImpl"
    ],
    "sodium:config_api_user": [
      "me.pepperbell.continuity.client.config.SodiumConfigImpl"
    ]
  },
  "mixins": [
    "continuity.mixins.json"
  ],

  "depends": {
    "minecraft": "~26.1",
    "fabric-api": ">=0.145.4"
  },
  "breaks": {
    "sodium": "<0.8.9"
  }
}
